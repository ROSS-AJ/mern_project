# Copy this file to .env and fill in the values. Never commit .env.

# Connection string for MongoDB (the host "mongodb" is the Docker Compose service name)
MONGODB_URI=mongodb://mongodb:27017/CardsDB

# Port for the Node API server
PORT=5000

# Where uploaded score PDFs are kept (default: ./uploads)
# UPLOAD_DIR=/app/uploads
# Biggest score a project can hold, in MB (default 25)
# MAX_PROJECT_MB=25
# Space each account can use for its scores, in MB (default 100)
# MAX_STORAGE_MB=100
# Uploads stop when the server's disk has less than this free, in MB (default 1024)
# MIN_FREE_DISK_MB=1024
